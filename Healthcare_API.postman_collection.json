						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Gregory House\",\n    \"specialization\": \"Infectious Disease & Nephrology\",\n    \"contact_number\": \"+1-555-0300\",\n    \"email\": \"drhouse@diagnostics.org\",\n    \"years_of_experience\": 22,\n    \"hospital_affiliation\": \"Princeton-Plainsboro Teaching Hospital\"\n}"
