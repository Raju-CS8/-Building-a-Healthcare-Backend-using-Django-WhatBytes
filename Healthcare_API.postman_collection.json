				{
					"name": "Update Doctor Details",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Gregory House MD\",\n    \"specialization\": \"Diagnostic Medicine & Nephrology\",\n    \"contact_number\": \"+1-555-0399\",\n    \"email\": \"drhouse@diagnostics.org\",\n    \"years_of_experience\": 23,\n    \"hospital_affiliation\": \"Princeton-Plainsboro Teaching Hospital\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"doctors",
								"{{doctor_id}}",
								""
							]
						},
						"description": "Updates doctor information."
					},
					"response": []
