				{
					"name": "Delete Doctor Record",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
