									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('doctor_id', jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
