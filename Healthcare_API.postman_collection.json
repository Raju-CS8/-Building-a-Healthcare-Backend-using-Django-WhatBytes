		{
			"name": "4. Patient-Doctor Mapping",
			"item": [
				{
					"name": "Assign Doctor to Patient",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('mapping_id', jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"patient_id\": {{patient_id}},\n    \"doctor_id\": {{doctor_id}},\n    \"notes\": \"Assigned for specialized diagnostic review.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/mappings/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"mappings",
								""
							]
						},
						"description": "Assigns a doctor to a patient."
					},
					"response": []
				},
				{
					"name": "Retrieve All Mappings",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/mappings/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"mappings",
								""
							]
						},
						"description": "Retrieves all patient-doctor mappings."
					},
					"response": []
				},
				{
					"name": "Get Doctors Assigned to Specific Patient",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/mappings/{{patient_id}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"mappings",
								"{{patient_id}}",
								""
							]
						},
						"description": "Retrieves all doctors assigned to a specific patient."
					},
					"response": []
				},
				{
					"name": "Remove Doctor from Patient (Delete Mapping)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/mappings/{{mapping_id}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"mappings",
								"{{mapping_id}}",
								""
							]
						},
						"description": "Removes a doctor from a patient by deleting the mapping record."
					},
					"response": []
				}
